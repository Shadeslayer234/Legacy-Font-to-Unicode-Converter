{
  "name": "@lk-unicode/core",
  "version": "0.0.0",
  "description": "Convert text typed in legacy Sinhala and Tamil fonts (FM, DL, Bamini) to Unicode, and back.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mappings/schema.json": "./mappings/schema.json"
  },
  "files": [
    "dist",
    "mappings"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2"
  }
}
